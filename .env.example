# Copy this file to .env and fill in real values.
# APP_ENV and SECRET_KEY are required - the app refuses to start without them.

# development | testing | production
APP_ENV=development

# Required. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Never commit a real value or reuse this placeholder.
SECRET_KEY=

# Optional - omit to use a local SQLite file under instance/.
DATABASE_URL=

SESSION_COOKIE_SECURE=True
REMEMBER_COOKIE_SECURE=True
SESSION_TIMEOUT_MINUTES=60
REMEMBER_COOKIE_DAYS=14

# Set True only when deployed behind exactly one reverse proxy (nginx, etc.)
# so ProxyFix reads the real client IP from X-Forwarded-*.
BEHIND_PROXY=False

# memory:// only works correctly with a single worker process. Point this at
# a shared store (e.g. redis://localhost:6379/0) if running gunicorn with
# more than one worker.
RATELIMIT_STORAGE_URI=memory://

# Runs the daily automated-checks job (license/contract expirations,
# utilization, unused licenses) in-process. Run only one worker when this
# is True, to avoid duplicate notification runs.
SCHEDULER_ENABLED=False

# Optional - password-reset emails fall back to an unlogged admin-visible
# notice when unset (see app/services/mailer.py).
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# Optional SIS/roster integrations - all disabled unless explicitly enabled.
SYNERGY_ENABLED=False
SYNERGY_BASE_URL=
SYNERGY_API_KEY=

CLEVER_ENABLED=False
CLEVER_CLIENT_ID=
CLEVER_CLIENT_SECRET=

CANVAS_ENABLED=False
CANVAS_BASE_URL=
CANVAS_API_TOKEN=

MAX_CONTENT_LENGTH_MB=5
UPLOAD_FOLDER=instance/uploads

LOG_LEVEL=INFO
